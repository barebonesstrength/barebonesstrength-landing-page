---
import HeroCopy from "./HeroCopy.astro";

// Hero with a `mode` switch. All three layouts share the same HeroCopy block.
//   split — copy left, media right (default)
//   vsl   — centered copy with a video player
//   text  — copy only, centered, no media
interface Props {
  mode?: "split" | "vsl" | "text";
  eyebrow?: string;
  headline: string;
  subheadline?: string;
  bullets?: string[];
  ctaLabel: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  trustLabel?: string;
  /** Trust-row avatar photos. Falls back to placeholders if not supplied. */
  avatars?: string[];
  /** split: right-hand image · vsl: video poster */
  image?: string;
  imageAlt?: string;
  /** vsl: where the play button links (your video URL) */
  videoUrl?: string;
  /** cream: the primary/secondary colour experiment. Default neutral. */
  tone?: "surface" | "cream";
}

const {
  mode = "text",
  eyebrow,
  headline,
  subheadline,
  bullets = [],
  ctaLabel,
  ctaHref,
  secondaryLabel,
  secondaryHref,
  trustLabel,
  avatars,
  image,
  imageAlt = "",
  videoUrl,
  tone = "surface",
} = Astro.props;

const isCream = tone === "cream";
const heroSectionBg = isCream ? "bg-secondary" : "";
const mediaFrame = isCream
  ? "border-ink-fixed/15 bg-white"
  : "border-line bg-surface-2";
const playIcon = isCream ? "text-ink-fixed" : "text-ink";

// Shared content passed to HeroCopy in every mode.
const copy = {
  eyebrow,
  headline,
  subheadline,
  ctaLabel,
  ctaHref,
  secondaryLabel,
  secondaryHref,
  trustLabel,
  avatars,
  tone,
};

// vsl mode: pull the YouTube ID out of any common URL shape (youtu.be/ID,
// youtube.com/watch?v=ID, youtube.com/embed/ID) so the video can play inline
// instead of just linking out. Falls back to a plain link-out for non-YouTube
// video URLs (Vimeo, Wistia, etc.) where there's no ID to embed.
const ytId = videoUrl?.match(
  /(?:youtu\.be\/|youtube(?:-nocookie)?\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{11})/
)?.[1];
const vslPoster =
  image ?? (ytId ? `https://img.youtube.com/vi/${ytId}/maxresdefault.jpg` : "https://picsum.photos/seed/ttb-vsl/1280/720");
---

{
  mode === "split" && (
    <section class={heroSectionBg}>
      <div class="mx-auto max-w-6xl px-6 pb-16 pt-12 lg:pt-16">
        <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
          <HeroCopy align="left" {...copy} bullets={bullets} />
          <div class="hidden lg:block lg:pl-4">
            <div class={`overflow-hidden rounded-card border ${mediaFrame} shadow-xl shadow-black/5`}>
              <img
                src={image ?? "https://picsum.photos/seed/ttb-offer-hero/1100/900"}
                alt={imageAlt}
                width="1100"
                height="900"
                class="h-auto w-full"
                loading="eager"
              />
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

{
  mode === "text" && (
    <section class={heroSectionBg}>
      <div class="mx-auto max-w-3xl px-6 pb-16 pt-16 lg:pt-24">
        <HeroCopy align="center" {...copy} bullets={bullets} />
      </div>
    </section>
  )
}

{
  mode === "vsl" && (
    <section class={heroSectionBg}>
      <div class="mx-auto max-w-3xl px-6 pb-16 pt-14 lg:pt-20">
        <HeroCopy align="center" {...copy}>
          {ytId ? (
            <div
              slot="media"
              data-yt-facade
              data-yt-id={ytId}
              role="button"
              tabindex="0"
              aria-label="Play video"
              class={`group relative block aspect-video w-full cursor-pointer overflow-hidden rounded-card border ${mediaFrame} shadow-xl shadow-black/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2`}
            >
              <img
                src={vslPoster}
                alt={imageAlt}
                width="1280"
                height="720"
                class="h-full w-full object-cover"
                loading="eager"
              />
              <span class="absolute inset-0 grid place-items-center bg-black/20 transition-colors group-hover:bg-black/30">
                <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white/90 shadow-lg backdrop-blur transition-transform group-hover:scale-105">
                  <svg
                    class={`ml-1 h-6 w-6 ${playIcon}`}
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </span>
              </span>
            </div>
          ) : (
            <a
              slot="media"
              href={videoUrl ?? "#"}
              aria-label="Play video"
              class={`group relative block aspect-video w-full overflow-hidden rounded-card border ${mediaFrame} shadow-xl shadow-black/5`}
            >
              <img
                src={vslPoster}
                alt={imageAlt}
                width="1280"
                height="720"
                class="h-full w-full object-cover"
                loading="eager"
              />
              <span class="absolute inset-0 grid place-items-center bg-black/20 transition-colors group-hover:bg-black/30">
                <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white/90 shadow-lg backdrop-blur transition-transform group-hover:scale-105">
                  <svg
                    class={`ml-1 h-6 w-6 ${playIcon}`}
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </span>
              </span>
            </a>
          )}
        </HeroCopy>
      </div>
    </section>
  )
}

<script>
  // Click-to-embed YouTube facade: keeps the initial page load light (just a
  // poster image) and only loads the actual YouTube iframe once someone
  // clicks play, so it's a real inline embed without the up-front weight.
  document.querySelectorAll<HTMLElement>("[data-yt-facade]").forEach((el) => {
    const play = () => {
      const id = el.dataset.ytId;
      if (!id) return;
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = "YouTube video player";
      iframe.className = "h-full w-full";
      iframe.setAttribute("frameborder", "0");
      iframe.setAttribute(
        "allow",
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      );
      iframe.setAttribute("allowfullscreen", "");
      el.replaceChildren(iframe);
      el.removeAttribute("role");
      el.removeAttribute("tabindex");
    };
    el.addEventListener("click", play);
    el.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        play();
      }
    });
  });
</script>
