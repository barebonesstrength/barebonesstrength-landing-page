---
// Rotating photo carousel - one photo at a time, auto-plays, click a dot or
// arrow to jump directly. Same rotation/pause/reduced-motion mechanics as
// StudentWins.astro, just photo + caption instead of a full quote card.
interface Item {
  name: string;
  image: string;
  alt?: string;
}
interface Props {
  eyebrow?: string;
  heading: string;
  subheading?: string;
  items: Item[];
  /** surface/surface-2: the default neutral bands. brand/cream: the bold
   * primary/secondary experiment - card colour inverts against the section
   * so it always reads. */
  tone?: "surface" | "surface-2" | "brand" | "cream";
}

const {
  eyebrow,
  heading,
  subheading,
  items,
  tone = "surface-2",
} = Astro.props;

const isBrand = tone === "brand";
const isCream = tone === "cream";

const sectionBg =
  tone === "surface" ? "bg-surface"
  : tone === "surface-2" ? "bg-surface-2"
  : isBrand ? "bg-brand-500"
  : "bg-secondary";
const headingText = isBrand ? "text-white" : isCream ? "text-ink-fixed" : "text-ink";
const subText = isBrand ? "text-white/75" : isCream ? "text-ink-fixed/70" : "text-ink-muted";
const eyebrowText = isBrand ? "text-white/80" : "text-brand-600";

// Card flips to the opposite brand colour so it always reads clearly.
const cardBg = isBrand ? "bg-secondary" : isCream ? "bg-brand-500" : "bg-card";
const cardBorder = isBrand ? "border-ink-fixed/10" : isCream ? "border-white/15" : "border-line";
const cardCaption = isBrand ? "text-ink-fixed" : isCream ? "text-white" : "text-ink";

const navBtn =
  isBrand ? "border-white/30 text-white/70 hover:bg-white/10 hover:text-white"
  : isCream ? "border-ink-fixed/20 text-ink-fixed/70 hover:bg-ink-fixed/5 hover:text-ink-fixed"
  : "border-line text-ink-muted hover:bg-surface-2 hover:text-ink";
const dotIdle = isBrand ? "bg-white/30" : isCream ? "bg-ink-fixed/20" : "bg-line";
const dotActive = isBrand ? "bg-white" : "bg-brand-500";
---

<section class={sectionBg}>
  <div class="mx-auto max-w-3xl px-6 py-16 md:py-20">
    <div class="mx-auto max-w-2xl text-center">
      {
        eyebrow && (
          <p class={`text-sm font-bold uppercase tracking-wide ${eyebrowText}`}>
            {eyebrow}
          </p>
        )
      }
      <h2 class={`mt-3 text-3xl font-bold tracking-tight md:text-4xl ${headingText}`}>
        {heading}
      </h2>
      {
        subheading && (
          <p class={`mx-auto mt-4 max-w-xl text-lg leading-relaxed ${subText}`}>
            {subheading}
          </p>
        )
      }
    </div>

    <div class="relative mt-10" data-photos data-dot-active={dotActive} data-dot-idle={dotIdle}>
      <!-- Slides stacked in one grid cell, centred and width-capped -->
      <div class="mx-auto grid max-w-xs">
        {
          items.map((item, i) => (
            <figure
              class={`col-start-1 row-start-1 overflow-hidden rounded-card border ${cardBorder} ${cardBg} shadow-sm shadow-black/5 transition-all duration-500 ease-out ${
                i === 0
                  ? "opacity-100"
                  : "pointer-events-none translate-y-3 scale-[0.98] opacity-0"
              }`}
              data-photos-slide
              data-index={i}
              aria-hidden={i === 0 ? "false" : "true"}
            >
              <img
                src={item.image}
                alt={item.alt ?? `${item.name}'s transformation`}
                width="800"
                height="800"
                class="aspect-square w-full object-contain"
                loading={i === 0 ? "eager" : "lazy"}
              />
              <figcaption class={`px-4 py-3 text-center text-sm font-semibold ${cardCaption}`}>
                {item.name}
              </figcaption>
            </figure>
          ))
        }
      </div>

      {
        items.length > 1 && (
          <div class="mt-7 flex items-center justify-center gap-4">
            <button
              type="button"
              data-photos-prev
              aria-label="Previous photo"
              class={`flex h-9 w-9 items-center justify-center rounded-full border transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 ${navBtn}`}
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m15 18-6-6 6-6" />
              </svg>
            </button>

            <div class="flex flex-wrap items-center justify-center gap-2" data-photos-dots>
              {items.map((item, i) => (
                <button
                  type="button"
                  data-photos-dot
                  data-index={i}
                  aria-label={`Go to ${item.name}`}
                  class={`h-2 w-2 rounded-full transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 ${dotIdle}`}
                />
              ))}
            </div>

            <button
              type="button"
              data-photos-next
              aria-label="Next photo"
              class={`flex h-9 w-9 items-center justify-center rounded-full border transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 ${navBtn}`}
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 6 6 6-6 6" />
              </svg>
            </button>
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  // Toggled at runtime; listed here so Tailwind keeps them in the build:
  // bg-brand-500 bg-white bg-secondary w-5 bg-line bg-white/30 bg-ink-fixed/20 w-2 opacity-100 opacity-0 translate-y-3 scale-[0.98] pointer-events-none
  document.querySelectorAll<HTMLElement>("[data-photos]").forEach((root) => {
    const slides = Array.from(
      root.querySelectorAll<HTMLElement>("[data-photos-slide]")
    );
    const dots = Array.from(
      root.querySelectorAll<HTMLElement>("[data-photos-dot]")
    );
    if (slides.length < 2) return;

    const dotActiveClass = root.dataset.dotActive || "bg-brand-500";
    const dotIdleClass = root.dataset.dotIdle || "bg-line";

    let current = 0;
    let timer: number | undefined;
    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    const show = (n: number) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === current;
        slide.classList.toggle("opacity-100", active);
        slide.classList.toggle("opacity-0", !active);
        slide.classList.toggle("translate-y-3", !active);
        slide.classList.toggle("scale-[0.98]", !active);
        slide.classList.toggle("pointer-events-none", !active);
        slide.setAttribute("aria-hidden", active ? "false" : "true");
      });
      dots.forEach((dot, i) => {
        const active = i === current;
        dot.classList.toggle(dotActiveClass, active);
        dot.classList.toggle("w-5", active);
        dot.classList.toggle(dotIdleClass, !active);
        dot.classList.toggle("w-2", !active);
      });
    };

    const next = () => show(current + 1);

    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      if (reduce) return;
      stop();
      timer = window.setInterval(next, 3500);
    };

    root
      .querySelector("[data-photos-next]")
      ?.addEventListener("click", () => {
        show(current + 1);
        start();
      });
    root
      .querySelector("[data-photos-prev]")
      ?.addEventListener("click", () => {
        show(current - 1);
        start();
      });
    dots.forEach((dot) =>
      dot.addEventListener("click", () => {
        show(Number(dot.dataset.index));
        start();
      })
    );

    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", start);

    show(0);
    start();
  });
</script>
