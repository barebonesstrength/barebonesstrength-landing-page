---
import { site } from "../config";

interface Props {
  /** Show the brand name next to the mark. Off by default - the logo image
   * already has "Barebones Strength" worked into the badge. */
  showName?: boolean;
}

const { showName = false } = Astro.props;
---

<a href="/" class="flex items-center gap-2" aria-label={site.name}>
  <img
    src="/images/logo.png"
    alt={site.name}
    width="337"
    height="297"
    class="h-10 w-auto"
  />

  {showName && (
    <span class="text-base font-bold tracking-tight text-ink">{site.name}</span>
  )}
</a>
